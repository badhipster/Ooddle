# ─────────────────────────────────────────────────────────
# Ooddle — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy to .env.local for development.
# Add these in Vercel Project Settings → Environment Variables for production.

# Groq API Key (FREE — no credit card required)
# Get one at: https://console.groq.com/keys
# Free tier: 30 requests/min, 6000 requests/day with Llama 3.3 70B
# If unset, the app gracefully falls back to curated mock responses.
GROQ_API_KEY=

# Optional: switch the public-facing URL (for CORS on /api/*)
# NEXT_PUBLIC_APP_URL=https://ooddle.vercel.app
